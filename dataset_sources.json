{
  "_comment": "Set the environment variable PLANTCARE_SOURCES to the folder created by get_datasets.sh. See README section 3.",
  "_sources": {
    "plantvillage": "PlantVillage (Hughes & Salathe 2015), github.com/spMohanty/PlantVillage-Dataset, CC BY-SA 3.0",
    "mangoleafbd": "MangoLeafBD (Ahmed et al. 2023, Data in Brief), Mendeley 10.17632/hxsnvwty3r.1, CC BY 4.0; copy from github.com/DevyanshMalhotra/MangoLeafDiseaseDetection",
    "rice": "Rice Diseases Image Dataset (Huy Minh Do, Kaggle), field photos; copy from github.com/jonathanrjpereira/Rice-Disease-Classification (Rice_All.zip)",
